# AgentPDP runtime environment — installed ONCE to /opt/agentpdp/env (mode 600, owner agentpdp)
# by scripts/server-setup.sh. Later edits are made by hand on the server, then:
#   systemctl restart agentpdp
PORT=8787
# Public origin used in links returned to agents. Update when the hostname changes.
PUBLIC_ORIGIN=https://188-166-163-33.sslip.io
# Use the headless Chromium fallback in the extractor when static extraction fails.
HEADLESS_FALLBACK=1
PLAYWRIGHT_BROWSERS_PATH=/opt/agentpdp/pw-browsers
GROQ_MODEL=llama-3.3-70b-versatile
# Filled in by hand on the server. Never commit a value here.
GROQ_API_KEY=
