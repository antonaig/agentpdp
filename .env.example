PORT=8787
# Optional: enables LLM-grounded answers for ask_about_product. Without it the tool answers deterministically from extracted data.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Public origin of this deployment, used in links returned to agents.
PUBLIC_ORIGIN=http://localhost:5173
# Headless-browser rung of the extractor for JS-rendered or bot-walled pages (needs `npx playwright install chromium`).
HEADLESS_FALLBACK=1
# Optional: where Playwright browsers live (set on the server).
# PLAYWRIGHT_BROWSERS_PATH=
