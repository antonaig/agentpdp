{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true,
    "baseUrl": ".", "paths": { "@shared/*": ["shared/*"], "@/*": ["web/src/*"] }, "types": ["vite/client", "node"]
  },
  "include": ["web/src", "shared", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}
